{
  // Firepit per-project config. JSONC: comments and trailing commas are
  // allowed. Reference form: firepit-template/.firepit/config.json.

  "version": 1,
  "id": "sacrvm.dev",

  "commands": [
    {
      "group": "Run",
      "name": "site",
      "description": "Serves the site on 127.0.0.1:8765.",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "http.server", "8765", "--bind", "127.0.0.1"],
      "window": "reuse:site",
      "longRunning": true
    },

    {
      "group": "Open",
      "name": "live",
      "description": "Opens sacrvm.dev in the browser.",
      "type": "url",
      "url": "https://sacrvm.dev/"
    },

    {
      "group": "Git",
      "name": "repo",
      "description": "Opens this repository on GitHub.",
      "type": "url",
      "url": "https://github.com/SACRVM/sacrvm.dev"
    }
  ]
}
